# Public site URL. When set, the build adds canonical, og:url and absolute og:image tags.
VITE_SITE_URL=

# Where "Gửi ảnh" sends people. Leave empty to use quang@quanghuynh.com.
VITE_CONTACT_EMAIL=
# Optional extra channels, shown only when set (e.g. https://zalo.me/..., https://m.me/...).
VITE_CONTACT_ZALO_URL=
VITE_CONTACT_MESSENGER_URL=
